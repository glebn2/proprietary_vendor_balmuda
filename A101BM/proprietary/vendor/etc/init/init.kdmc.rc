######################################################################
# Config file for DIAG clients
#
# Syntax:
#   [App full path] param1 param2 param3 ...
#
# Example:
#   system/vendor/bin/ktestXdiag 1 0 3
######################################################################

on property:vendor.kc.diag.status=start && property:vendor.kc.diag.fact=kcfactoff
    class_start kc_diag

on property:vendor.kc.diag.status=start && property:vendor.kc.diag.fact=kcfacton
    class_start kc_fact_diag

######################################################################
# For Diag Common
######################################################################
on property:vendor.kc.diag.fact=kcfactoff
    class_start kc_diag_common

on property:vendor.kc.diag.fact=kcfacton
    class_start kc_fact_diag_common

on property:vendor.kc.diag.status=stop && property:vendor.kc.diag.fact=kcfactoff
    class_stop kc_diag 

on property:vendor.kc.diag.status=stop && property:vendor.kc.diag.fact=kcfacton
    class_stop kc_fact_diag

on property:sys.diagofflineservice=1
    class_start kcd_diag

on property:sys.diagofflineservice=0
    class_stop kcd_diag


######################################################################
# For HW :0x0000-0x1FFF
######################################################################
#---------------------------------------------------------------------
# i2c
#---------------------------------------------------------------------
service i2c_diag /system/vendor/bin/i2c_diag
    class kc_diag
    user system
    group root vendor_qti_diag
    oneshot

#---------------------------------------------------------------------
# MEM
#---------------------------------------------------------------------
service kdiagdiag /system/vendor/bin/kdiagdiag
